# Django secret key. Generate a unique value for each environment.
SECRET_KEY=

# Use True only for local development.
DEBUG=False

# Comma-separated hostnames/IPs accepted by Django, e.g. localhost,127.0.0.1,example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed by CORS, e.g. http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173

# Optional database connection URL. Defaults to db.sqlite3 when omitted.
# DATABASE_URL=postgres://user:password@host:5432/database_name

# Log level for the acceso application logger.
LOG_LEVEL=INFO

# Máximo de lecturas OCR por usuario; 60/min es apropiado para pruebas en terreno.
OCR_RECOGNITION_THROTTLE_RATE=60/min

# Rendimiento y selección de resultados OCR.
OCR_MAX_DIM=1600
OCR_MIN_ALTO=90
OCR_TIMEOUT_VARIANTE=5
OCR_PRESUPUESTO_TOTAL=8
OCR_CONFIANZA_MINIMA=45
OCR_CONFIANZA_ALTA=80
OCR_USAR_HAAR=False
